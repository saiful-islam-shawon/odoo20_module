<odoo>
    <template id="report_voucher_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: Arial, sans-serif; font-size:12px; padding:15mm;">

                    <h2 style="text-align:center; font-size:28px; font-weight:bold; margin:0 0 35px 0;">
                        Receipt Voucher
                    </h2>

                    <table style="width:100%; border-collapse:collapse;">
                        <tbody>
                            <tr>
                                <td style="border:1px solid #000; width:20%; padding:10px;"><b>Customer</b></td>
                                <td style="border:1px solid #000; width:30%; padding:10px;">
                                    <span t-field="o.partner_id"/>
                                </td>
                                <td style="border:1px solid #000; width:20%; padding:10px;"><b>Date</b></td>
                                <td style="border:1px solid #000; width:30%; padding:10px;">
                                    <span t-field="o.date"/>
                                </td>
                            </tr>

                            <tr>
                                <td rowspan="2" style="border:1px solid #000; padding:10px; vertical-align:middle;"><b>Address</b></td>
                                <td rowspan="2" style="border:1px solid #000; padding:10px; vertical-align:middle;">
                                    <t t-set="address_parts" t-value="[
                                        o.partner_id.country_id.name,
                                        o.partner_id.city,
                                        o.partner_id.street
                                    ]"/>
                                    <span t-esc="', '.join([part for part in address_parts if part])"/>
                                </td>
                                <td style="border:1px solid #000; padding:10px;"><b>Created By</b></td>
                                <td style="border:1px solid #000; padding:10px;">
                                    <span t-field="o.create_uid"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:10px;"><b>Payment Type</b></td>
                                <td style="border:1px solid #000; padding:10px;">
                                    <span t-field="o.payment_mode"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:10px;"><b>Amount</b></td>
                                <td style="border:1px solid #000; padding:10px; font-weight:bold;">
                                    <span t-esc="'%.2f Taka' % o.amount_total"/>
                                </td>
                                <td style="border:1px solid #000; padding:10px;"><b>Status</b></td>
                                <td style="border:1px solid #000; padding:10px;">
                                    <span t-field="o.state"/>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:10px;"><b>Amount In<br/>Words</b></td>
                                <td colspan="3" style="border:1px solid #000; padding:10px;">
                                    <i><span t-esc="o.currency_id.amount_to_text(o.amount_total)"/> Only</i>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:1px solid #000; padding:10px; vertical-align:middle;"><b>Narration</b></td>
                                <td colspan="3" style="border:1px solid #000; padding:10px; vertical-align:middle;">
                                    <span t-esc="o.narration or ''"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h2 style="margin-top:25px; margin-bottom:10px; font-size:22px; font-weight:bold;">Invoice</h2>

                    <table style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th style="border:1px solid #000; padding:10px;">Invoice Number</th>
                                <th style="border:1px solid #000; padding:10px;">Date</th>
                                <th style="border:1px solid #000; padding:10px;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="o.invoice_id">
                                <tr>
                                    <td style="border:1px solid #000; padding:10px;"><span t-field="o.invoice_id.name"/></td>
                                    <td style="border:1px solid #000; padding:10px;"><span t-field="o.invoice_id.invoice_date"/></td>
                                    <td style="border:1px solid #000; padding:10px;"><span t-esc="'%.2f Taka' % o.invoice_id.amount_total"/></td>
                                </tr>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="3" style="border:1px solid #000; padding:10px; text-align:center;">
                                        No Invoice Selected
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div style="margin-top:220px;">
                        <table style="width:100%;">
                            <tr>
                                <td style="text-align:center; width:50%;">
                                    _______________________<br/>
                                    Received By
                                </td>
                                <td style="text-align:center; width:50%;">
                                    _______________________<br/>
                                    Authorized Signature
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </t>
    </template>

</odoo>
