<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_payment_voucher_document">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="o">

                <!-- Odoo Default Header + Footer -->
                <t t-call="web.external_layout">

                    <style type="text/css">

                        .payment-voucher-page {
                            font-family: Arial, sans-serif;
                            font-size: 12px;
                            padding-top: 30mm;
                        }

                        .payment-voucher-table {
                            width: 100%;
                            border-collapse: collapse;
                        }

                        .payment-voucher-table td,
                        .payment-voucher-table th {
                            border: 1px solid #000;
                            padding: 10px;
                            text-align: center;
                            vertical-align: middle;
                        }

                    </style>


                    <div class="page payment-voucher-page">

                        <!-- =========================
                             TITLE
                        ========================== -->

                        <h2 style="
                            text-align:center;
                            font-size:28px;
                            font-weight:bold;
                            margin:0 0 25px 0;
                            padding:0;
                        ">
                            Payment Voucher
                        </h2>


                        <!-- =========================
                             MAIN INFORMATION TABLE
                        ========================== -->

                        <table class="payment-voucher-table">

                            <tbody>

                                <!-- Vendor + Date -->

                                <tr>

                                    <td style="width:20%;">
                                        <b>Vendor</b>
                                    </td>

                                    <td style="width:30%;">
                                        <span t-field="o.partner_id"/>
                                    </td>


                                    <td style="width:20%;">
                                        <b>Date</b>
                                    </td>

                                    <td style="width:30%;">
                                        <span t-field="o.date"/>
                                    </td>

                                </tr>


                                <!-- Address + Created By -->

                                <tr>

                                    <td rowspan="2">
                                        <b>Address</b>
                                    </td>


                                    <td rowspan="2">

                                        <t t-set="address_parts"
                                           t-value="[
                                               o.partner_id.country_id.name,
                                               o.partner_id.city,
                                               o.partner_id.street
                                           ]"/>

                                        <span t-esc="
                                            ', '.join(
                                                [part for part in address_parts if part]
                                            )
                                        "/>

                                    </td>


                                    <td>
                                        <b>Created By</b>
                                    </td>

                                    <td>
                                        <span t-field="o.create_uid"/>
                                    </td>

                                </tr>


                                <!-- Payment Type -->

                                <tr>

                                    <td>
                                        <b>Payment Type</b>
                                    </td>

                                    <td>
                                        <span t-field="o.payment_mode"/>
                                    </td>

                                </tr>


                                <!-- Amount + Status -->

                                <tr>

                                    <td>
                                        <b>Amount</b>
                                    </td>

                                    <td style="font-weight:bold;">
                                        <span t-esc="'%.2f Taka' % o.amount_total"/>
                                    </td>


                                    <td>
                                        <b>Status</b>
                                    </td>

                                    <td>
                                        <span t-field="o.state"/>
                                    </td>

                                </tr>


                                <!-- Amount In Words -->

                                <tr>

                                    <td>
                                        <b>
                                            Amount In
                                            <br/>
                                            Words
                                        </b>
                                    </td>


                                    <td colspan="3">

                                        <i>
                                            <span t-esc="
                                                o.currency_id.amount_to_text(
                                                    o.amount_total
                                                )
                                            "/>

                                            Only
                                        </i>

                                    </td>

                                </tr>


                                <!-- Narration -->

                                <tr>

                                    <td>
                                        <b>Narration</b>
                                    </td>


                                    <td colspan="3"
                                        style="word-wrap:break-word;">

                                        <span t-esc="o.narration or ''"/>

                                    </td>

                                </tr>

                            </tbody>

                        </table>


                        <!-- =========================
                             VENDOR BILL
                        ========================== -->

                        <h2 style="
                            margin-top:30px;
                            margin-bottom:10px;
                            font-size:21px;
                            font-weight:bold;
                        ">
                            Vendor Bill
                        </h2>


                        <table class="payment-voucher-table">

                            <thead>

                                <tr>

                                    <th style="width:40%; font-weight:bold;">
                                        Bill Number
                                    </th>

                                    <th style="width:30%; font-weight:bold;">
                                        Date
                                    </th>

                                    <th style="width:30%; font-weight:bold;">
                                        Amount
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <!-- Bill Selected -->

                                <t t-if="o.invoice_id">

                                    <tr>

                                        <td>
                                            <span t-field="o.invoice_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="o.invoice_id.invoice_date"/>
                                        </td>

                                        <td>
                                            <span t-esc="
                                                '%.2f Taka'
                                                % o.invoice_id.amount_total
                                            "/>
                                        </td>

                                    </tr>

                                </t>


                                <!-- No Bill Selected -->

                                <t t-else="">

                                    <tr>

                                        <td colspan="3">
                                            No Bill Selected
                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>


                        <!-- =========================
                             SIGNATURE SECTION
                        ========================== -->

                        <div style="
                            margin-top:140px;
                            padding:0 45px;
                            overflow:hidden;
                            page-break-inside:avoid;
                        ">


                            <!-- LEFT -->

                            <div style="
                                float:left;
                                width:40%;
                                text-align:center;
                            ">

                                __________________________

                                <br/>

                                <span style="font-weight:bold;">
                                    Paid By
                                </span>

                            </div>


                            <!-- RIGHT -->

                            <div style="
                                float:right;
                                width:40%;
                                text-align:center;
                            ">

                                __________________________

                                <br/>

                                <span style="font-weight:bold;">
                                    Authorized Signature
                                </span>

                            </div>


                        </div>


                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>