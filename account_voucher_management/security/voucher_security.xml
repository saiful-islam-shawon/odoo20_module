<odoo>
  <record id="module_category_voucher" model="ir.module.category">
    <field name="name">Voucher Management</field>
    <field name="sequence">30</field>
  </record>
  <record id="privilege_voucher" model="res.groups.privilege">
    <field name="name">Voucher Management</field>
    <field name="category_id" ref="module_category_voucher"/>
    <field name="sequence">30</field>
  </record>
  <record id="group_voucher_user" model="res.groups">
    <field name="name">Voucher User</field><field name="privilege_id" ref="privilege_voucher"/>
    <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
  </record>
  <record id="group_voucher_approver" model="res.groups">
    <field name="name">Voucher Approver</field><field name="privilege_id" ref="privilege_voucher"/>
    <field name="implied_ids" eval="[(4, ref('group_voucher_user'))]"/>
  </record>
  <record id="group_voucher_manager" model="res.groups">
    <field name="name">Voucher Accountant/Manager</field><field name="privilege_id" ref="privilege_voucher"/>
    <field name="implied_ids" eval="[(4, ref('group_voucher_approver')), (4, ref('account.group_account_invoice'))]"/>
  </record>
</odoo>
