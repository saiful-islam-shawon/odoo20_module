<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================= -->
    <!-- SEARCH VIEWS                                            -->
    <!-- ======================================================= -->

    <!-- Base Voucher Search View -->
    <record id="view_voucher_search" model="ir.ui.view">
        <field name="name">account.voucher.search</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <search>

                <field name="voucher_number"/>
                <field name="partner_id"/>
                <field name="invoice_id" string="Invoice Reference"/>
                <field name="reference"/>
                <field name="cheque_number"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="journal_id"/>
                <field name="company_id"/>

                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>

                <filter name="submitted" string="Submitted"
                        domain="[('state', '=', 'submitted')]"/>

                <filter name="waiting" string="Waiting for Approval"
                        domain="[('state', '=', 'waiting')]"/>

                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>

                <filter name="posted" string="Posted"
                        domain="[('state', '=', 'posted')]"/>

                <filter name="cancelled" string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>

                <filter name="filter_date"
                        string="Voucher Date"
                        date="date"/>

                <filter name="cheques"
                        string="Cheques"
                        domain="[('payment_mode', '=', 'cheque')]"/>

                <filter name="cheques_pending"
                        string="Pending Cheques"
                        domain="[('payment_mode', '=', 'cheque'),
                                ('cheque_status', 'in',
                                ('received', 'issued', 'deposited'))]"/>

                <group>

                    <filter string="State"
                            name="group_state"
                            context="{'group_by': 'state'}"/>

                    <filter string="Date"
                            name="group_date"
                            context="{'group_by': 'date'}"/>

                    <filter string="Partner"
                            name="group_partner"
                            context="{'group_by': 'partner_id'}"/>

                    <filter string="Journal"
                            name="group_journal"
                            context="{'group_by': 'journal_id'}"/>

                    <filter string="Debit Account"
                            name="group_debit"
                            context="{'group_by': 'debit_account_id'}"/>

                    <filter string="Credit Account"
                            name="group_credit"
                            context="{'group_by': 'credit_account_id'}"/>

                    <filter string="Company"
                            name="group_company"
                            context="{'group_by': 'company_id'}"/>

                </group>

            </search>
        </field>
    </record>


    <!-- ======================================================= -->
    <!-- LIST (TREE) VIEWS                                       -->
    <!-- ======================================================= -->

    <!-- Receipt Voucher List -->
    <record id="view_receipt_voucher_list" model="ir.ui.view">
        <field name="name">receipt.voucher.list</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <list string="Receipt Vouchers" decoration-muted="state == 'cancelled'">
                <field name="voucher_number"/>
                <field name="date"/>
                <field name="partner_id" string="Customer"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="amount_total" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="journal_id" string="Receipt Journal"/>
                <field name="invoice_id" string="Reference"/>
                <field name="state"/>
                <field name="accounting_move_id"/>
            </list>
        </field>
    </record>

    <!-- Payment Voucher List -->
    <record id="view_payment_voucher_list" model="ir.ui.view">
        <field name="name">payment.voucher.list</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <list string="Payment Vouchers" decoration-muted="state == 'cancelled'">
                <field name="voucher_number"/>
                <field name="date"/>
                <field name="partner_id" string="Vendor"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="journal_id" string="Payment Journal"/>
                <field name="invoice_id" string="Reference"/>
                <field name="state"/>
                <field name="accounting_move_id"/>
            </list>
        </field>
    </record>

    <!-- Contra Voucher List -->
    <record id="view_contra_voucher_list" model="ir.ui.view">
        <field name="name">contra.voucher.list</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <list string="Contra Vouchers">
                <field name="voucher_number"/>
                <field name="date"/>
                <field name="source_journal_id"/>
                <field name="destination_journal_id"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="reference"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Expense Voucher List -->
    <record id="view_expense_voucher_list" model="ir.ui.view">
        <field name="name">expense.voucher.list</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <list string="Expense Vouchers">
                <field name="voucher_number"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="journal_id"/>
                <field name="reference"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Journal Voucher List -->
    <record id="view_journal_voucher_list" model="ir.ui.view">
        <field name="name">journal.voucher.list</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <list string="Journal Vouchers">
                <field name="voucher_number"/>
                <field name="date"/>
                <field name="reference"/>
                <field name="total_debit"/>
                <field name="total_credit"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"/>
                <field name="accounting_move_id"/>
            </list>
        </field>
    </record>

    <!-- All Voucher List -->
    <record id="view_all_voucher_list" model="ir.ui.view">
        <field name="name">all.voucher.list</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <list string="Voucher List" create="0" decoration-muted="state == 'cancelled'">
                <field name="voucher_number"/>
                <field name="voucher_type"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="payment_mode"/>
                <field name="cheque_number" optional="hide"/>
                <field name="cheque_status" optional="hide"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="amount_total" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="invoice_id" string="Invoice Reference" optional="hide"/>
                <field name="reference"/>
                <field name="state"/>
                <field name="accounting_move_id"/>
            </list>
        </field>
    </record>

    <!-- Cheque Register List -->
    <record id="view_cheque_register_list" model="ir.ui.view">
        <field name="name">voucher.cheque.register.list</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <list string="Cheque Register" create="0"
                  decoration-success="cheque_status == 'cleared'"
                  decoration-danger="cheque_status in ('bounced', 'cancelled')"
                  decoration-warning="cheque_status in ('received', 'issued', 'deposited')">
                <field name="cheque_number"/>
                <field name="cheque_direction"/>
                <field name="cheque_date"/>
                <field name="cheque_bank_id"/>
                <field name="cheque_branch" optional="show"/>
                <field name="cheque_payee"/>
                <field name="partner_id"/>
                <field name="voucher_number"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="cheque_status"/>
                <field name="cheque_cleared_date" optional="hide"/>
            </list>
        </field>
    </record>


    <!-- ======================================================= -->
    <!-- FORM VIEWS                                              -->
    <!-- ======================================================= -->

    <!-- Base Voucher Form View -->
    <record id="view_voucher_form" model="ir.ui.view">
        <field name="name">account.voucher.form</field>
        <field name="model">account.voucher</field>
        <field name="arch" type="xml">
            <form string="Accounting Voucher">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_waiting" string="Send for Approval" type="object" invisible="state != 'submitted'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" groups="account_voucher_management.group_voucher_approver" invisible="state != 'waiting'"/>
                    <button name="action_reject" string="Reject" type="object" groups="account_voucher_management.group_voucher_approver" invisible="state not in ('submitted', 'waiting')"/>
                    <button name="action_post" string="Post" type="object" class="btn-primary" groups="account_voucher_management.group_voucher_manager" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" groups="account_voucher_management.group_voucher_manager" invisible="state in ('posted', 'cancelled')"/>
                    <button name="action_reverse" string="Reverse" type="object" groups="account_voucher_management.group_voucher_manager" invisible="state != 'posted' or reversal_move_id"/>
                    <button name="action_print_voucher" string="Print Voucher" type="object" icon="fa-print"/>

                    <button name="action_cheque_deposit" string="Deposit Cheque" type="object" class="btn-primary" invisible="payment_mode != 'cheque' or cheque_direction != 'received' or cheque_status != 'received'"/>
                    <button name="action_cheque_clear" string="Clear Cheque" type="object" class="btn-primary" invisible="payment_mode != 'cheque' or (cheque_direction == 'received' and cheque_status != 'deposited') or (cheque_direction == 'issued' and cheque_status != 'issued')"/>
                    <button name="action_cheque_bounce" string="Bounce Cheque" type="object" invisible="payment_mode != 'cheque' or cheque_status not in ('received', 'issued', 'deposited')"/>
                    <button name="action_cheque_cancel" string="Cancel Cheque" type="object" invisible="payment_mode != 'cheque' or cheque_status not in ('received', 'issued', 'deposited', 'bounced')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,waiting,approved,posted,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="fa-book" invisible="not accounting_move_id">
                            <field name="accounting_move_id" widget="statinfo" string="Journal Entry"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>

                    <div class="oe_title">
                        <label for="voucher_number"/>
                        <h1><field name="voucher_number"/></h1>
                    </div>

                    <field name="partner_commercial_id" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>

                    <group>
                        <group>
                            <field name="voucher_type"/>
                            <field name="date"/>
                            <field name="outstanding_balance" widget="monetary" readonly="1" invisible="voucher_type not in ('receipt', 'payment')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="partner_id" string="Customer"
                                   domain="[('customer_rank', '&gt;', 0)]"
                                   context="{'res_partner_search_mode': 'customer'}"
                                   invisible="voucher_type != 'receipt'"
                                   required="voucher_type == 'receipt'"/>
                            <field name="partner_id" string="Vendor"
                                   domain="[('supplier_rank', '&gt;', 0)]"
                                   context="{'res_partner_search_mode': 'supplier'}"
                                   invisible="voucher_type != 'payment'"
                                   required="voucher_type == 'payment'"/>
                            <field name="partner_id" string="Partner" invisible="voucher_type in ('receipt', 'payment')"/>
                            <field name="currency_id"/>
                            <field name="invoice_id" string="Reference"
                                   domain="[('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial')), ('commercial_partner_id', '=', partner_commercial_id), ('company_id', '=', company_id)]"
                                   invisible="voucher_type != 'receipt'"
                                   readonly="not partner_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="invoice_id" string="Reference"
                                   domain="[('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial')), ('commercial_partner_id', '=', partner_commercial_id), ('company_id', '=', company_id)]"
                                   invisible="voucher_type != 'payment'"
                                   readonly="not partner_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="reference" invisible="voucher_type in ('receipt', 'payment')"/>
                            <field name="payment_mode" invisible="voucher_type not in ('receipt', 'payment', 'expense')"/>
                        </group>
                    </group>

                    <group string="Cheque Details" invisible="payment_mode != 'cheque'">
                        <group>
                            <field name="cheque_direction"/>
                            <field name="cheque_number" required="payment_mode == 'cheque'"/>
                            <field name="cheque_date" required="payment_mode == 'cheque'"/>
                            <field name="cheque_bank_id" required="payment_mode == 'cheque'"/>
                        </group>
                        <group>
                            <field name="cheque_branch"/>
                            <field name="cheque_payee"/>
                            <field name="cheque_status" widget="statusbar"/>
                            <field name="cheque_deposit_date" invisible="not cheque_deposit_date"/>
                            <field name="cheque_cleared_date" invisible="not cheque_cleared_date"/>
                            <field name="cheque_bounce_date" invisible="not cheque_bounce_date"/>
                            <field name="cheque_bounce_reason" placeholder="Required before marking the cheque as bounced"/>
                        </group>
                    </group>

                    <group string="Accounting Details" invisible="voucher_type == 'journal'">
                        <field name="debit_account_id" required="voucher_type != 'journal'"/>
                        <field name="credit_account_id" required="voucher_type != 'journal'"/>
                        <field name="amount_total" required="voucher_type != 'journal'"/>
                    </group>

                    <field name="line_ids" invisible="voucher_type != 'journal'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="account_id"/>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="debit" sum="Total Debit"/>
                            <field name="credit" sum="Total Credit"/>
                            <field name="amount_currency" optional="hide"/>
                            <field name="analytic_distribution" widget="analytic_distribution" optional="show"/>
                        </list>
                    </field>

                    <group invisible="voucher_type != 'journal'">
                        <field name="total_debit"/>
                        <field name="total_credit"/>
                    </group>

                    <notebook>
                        <page string="Narration">
                            <field name="narration" placeholder="Purpose and supporting details..."/>
                        </page>
                        <page string="Approval &amp; Audit">
                            <group>
                                <field name="created_by"/>
                                <field name="approved_by"/>
                                <field name="approval_date"/>
                                <field name="posted_by"/>
                                <field name="posting_date"/>
                                <field name="rejection_reason"/>
                                <field name="rejected_by"/>
                                <field name="rejection_date"/>
                                <field name="reversal_move_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Inherited Form Views (Primary) -->
    <record id="view_receipt_voucher_form" model="ir.ui.view">
        <field name="name">receipt.voucher.form</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="view_voucher_form"/>
        <field name="mode">primary</field>

        <field name="arch" type="xml">

            <xpath expr="//form" position="attributes">
                <attribute name="string">Receipt Voucher</attribute>
            </xpath>

            <!-- Only Bank and Cash accounts in Receipt Voucher Debit Account -->
            <xpath expr="//field[@name='debit_account_id']" position="attributes">
                <attribute name="domain">[('account_type', '=', 'asset_cash')]</attribute>
            </xpath>


            <!-- Credit Account: Receivable only -->
            <xpath expr="//field[@name='credit_account_id']" position="attributes">
                <attribute name="domain">[('account_type', '=', 'asset_receivable')]</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_payment_voucher_form" model="ir.ui.view">
        <field name="name">payment.voucher.form</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="view_voucher_form"/>
        <field name="mode">primary</field>

        <field name="arch" type="xml">

            <xpath expr="//form" position="attributes">
                <attribute name="string">Payment Voucher</attribute>
            </xpath>

            <!-- Only Bank and Cash accounts in Payment Voucher Credit Account -->
            <xpath expr="//field[@name='credit_account_id']" position="attributes">
                <attribute name="domain">[('account_type', '=', 'asset_cash')]</attribute>
            </xpath>

            <!-- Debit Account: Payable only -->
            <xpath expr="//field[@name='debit_account_id']" position="attributes">
                <attribute name="domain">[('account_type', '=', 'liability_payable')]</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_contra_voucher_form" model="ir.ui.view">
        <field name="name">contra.voucher.form</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="view_voucher_form"/>
        <field name="mode">primary</field>

        <field name="arch" type="xml">

            <xpath expr="//form" position="attributes">
                <attribute name="string">Contra Voucher</attribute>
            </xpath>

            <!-- Hide generic Partner field -->
            <xpath expr="(//field[@name='partner_id'])[3]"
                  position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Reference -->
            <xpath expr="//field[@name='reference']"
                  position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- company -->
             <xpath expr="//field[@name='currency_id']" position="after">
                <xpath expr="//field[@name='company_id']" position="move"/>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="groups">base.group_user</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_expense_voucher_form" model="ir.ui.view">
        <field name="name">expense.voucher.form</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="view_voucher_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Expense Voucher</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_journal_voucher_form" model="ir.ui.view">
        <field name="name">journal.voucher.form</field>
        <field name="model">account.voucher</field>
        <field name="inherit_id" ref="view_voucher_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Journal Voucher</attribute>
            </xpath>
        </field>
    </record>


    <!-- ======================================================= -->
    <!-- WINDOW ACTIONS                                          -->
    <!-- ======================================================= -->

    <record id="action_receipt_voucher" model="ir.actions.act_window">
        <field name="name">Receipt Vouchers</field>
        <field name="res_model">account.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'receipt')]</field>
        <field name="context">{'default_voucher_type': 'receipt'}</field>
        <field name="search_view_id" ref="view_voucher_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_receipt_voucher_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_receipt_voucher_form')})]"/>
    </record>

    <record id="action_payment_voucher" model="ir.actions.act_window">
        <field name="name">Payment Vouchers</field>
        <field name="res_model">account.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'payment')]</field>
        <field name="context">{'default_voucher_type': 'payment'}</field>
        <field name="search_view_id" ref="view_voucher_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_payment_voucher_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_payment_voucher_form')})]"/>
    </record>

    <record id="action_contra_voucher" model="ir.actions.act_window">
        <field name="name">Contra Vouchers</field>
        <field name="res_model">account.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'contra')]</field>
        <field name="context">{'default_voucher_type': 'contra'}</field>
        <field name="search_view_id" ref="view_voucher_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_contra_voucher_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_contra_voucher_form')})]"/>
    </record>

    <record id="action_expense_voucher" model="ir.actions.act_window">
        <field name="name">Expense Vouchers</field>
        <field name="res_model">account.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'expense')]</field>
        <field name="context">{'default_voucher_type': 'expense'}</field>
        <field name="search_view_id" ref="view_voucher_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_expense_voucher_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_expense_voucher_form')})]"/>
    </record>

    <record id="action_journal_voucher" model="ir.actions.act_window">
        <field name="name">Journal Vouchers</field>
        <field name="res_model">account.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('voucher_type', '=', 'journal')]</field>
        <field name="context">{'default_voucher_type': 'journal'}</field>
        <field name="search_view_id" ref="view_voucher_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_journal_voucher_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_journal_voucher_form')})]"/>
    </record>

    <record id="action_all_vouchers" model="ir.actions.act_window">
        <field name="name">Voucher List</field>
        <field name="res_model">account.voucher</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_voucher_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_all_voucher_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_voucher_form')})]"/>
