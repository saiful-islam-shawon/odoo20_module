<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zc_rfq_create_wizard_form" model="ir.ui.view">
        <field name="name">zc.rfq.create.wizard.form</field>
        <field name="model">zc.rfq.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Vendor RFQ">
                <group>
                    <field name="requisition_id"/>
                    <field name="partner_id" options="{'no_create_edit': False}"/>
                    <field name="quotation_reference"/>
                    <field name="quotation_date"/>
                </group>
                <footer>
                    <button name="action_create_rfq" string="Create RFQ" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
