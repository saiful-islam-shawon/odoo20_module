<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zc_vendor_rfq_list" model="ir.ui.view">
        <field name="name">zc.vendor.rfq.list</field>
        <field name="model">zc.vendor.rfq</field>
        <field name="arch" type="xml">
            <list string="Vendor RFQs" default_order="id desc">
                <field name="name"/>
                <field name="requisition_id"/>
                <field name="partner_id"/>
                <field name="quotation_reference"/>
                <field name="quotation_date"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_zc_vendor_rfq_form" model="ir.ui.view">
        <field name="name">zc.vendor.rfq.form</field>
        <field name="model">zc.vendor.rfq</field>
        <field name="arch" type="xml">
            <form string="Vendor RFQ">
                <header>
                    <field name="is_locked" invisible="1"/>
                    <button name="action_mark_received" string="Mark Received" type="object" class="btn-primary" invisible="state != 'draft' or is_locked"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object" invisible="state != 'received' or is_locked"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled' or is_locked"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="requisition_id" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="quotation_reference" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="quotation_date" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state != 'draft' or is_locked">
                        <list editable="bottom" create="false" delete="false">
                            <field name="requisition_line_id" column_invisible="True"/>
                            <field name="product_id" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                            <field name="price_unit"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="quality"/>
                            <field name="delivery_date"/>
                        </list>
                    </field>
                    <separator string="Terms and Conditions"/>
                    <field name="terms_and_conditions" nolabel="1" placeholder="Terms and conditions..." readonly="state != 'draft' or is_locked"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_zc_vendor_rfq_search" model="ir.ui.view">
        <field name="name">zc.vendor.rfq.search</field>
        <field name="model">zc.vendor.rfq</field>
        <field name="arch" type="xml">
            <search string="Vendor RFQs">
                <field name="name"/>
                <field name="requisition_id"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <group name="group_by">
                    <filter string="Requisition" name="group_req" context="{'group_by': 'requisition_id'}"/>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_zc_vendor_rfq_line_comparison_list" model="ir.ui.view">
        <field name="name">zc.vendor.rfq.line.comparison.list</field>
        <field name="model">zc.vendor.rfq.line</field>
        <field name="arch" type="xml">
            <list string="RFQ Comparison" editable="bottom" create="false" delete="false" default_order="requisition_line_id, price_unit">
                <field name="requisition_line_id" string="Requisition Line" readonly="1" optional="hide"/>
                <field name="product_id" readonly="1"/>
                <field name="partner_id" readonly="1"/>
                <field name="rfq_id" readonly="1"/>
                <field name="quantity" readonly="1"/>
                <field name="product_uom_id" readonly="1"/>
                <field name="price_unit" readonly="1"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="quality" readonly="1" widget="badge"/>
                <field name="delivery_date" readonly="1"/>
                <field name="decision" widget="badge"/>
                <button name="action_recommend" string="Recommend" type="object" icon="check" invisible="decision == 'recommended' or purchase_order_line_id"/>
                <button name="action_reject" string="Reject" type="object" icon="close" invisible="decision == 'rejected' or purchase_order_line_id"/>
                <button name="action_cancel_decision" string="Cancel" type="object" icon="block" invisible="decision == 'cancelled' or purchase_order_line_id"/>
                <button name="action_reset_decision" string="Reset" type="object" icon="undo" invisible="decision == 'pending' or purchase_order_line_id"/>
                <field name="purchase_order_line_id" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_zc_vendor_rfq" model="ir.actions.act_window">
        <field name="name">Vendor Quotations</field>
        <field name="res_model">zc.vendor.rfq</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zc_vendor_rfq_search"/>
    </record>
</odoo>
