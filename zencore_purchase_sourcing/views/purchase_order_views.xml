<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_zc_requisition" model="ir.ui.view">
        <field name="name">purchase.order.form.zc.requisition</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="zc_requisition_id" invisible="1"/>
                <button name="action_view_zc_requisition"
                        type="object"
                        class="oe_stat_button"
                        icon="list_alt"
                        invisible="not zc_requisition_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Requisition</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="zc_requisition_id" readonly="1" invisible="not zc_requisition_id"/>
            </xpath>
        </field>
    </record>
</odoo>
