<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="seq_zc_purchase_requisition" model="ir.sequence">
        <field name="name">Purchase Requisition</field>
        <field name="code">zc.purchase.requisition</field>
        <field name="prefix">REQ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_zc_vendor_rfq" model="ir.sequence">
        <field name="name">Vendor RFQ</field>
        <field name="code">zc.vendor.rfq</field>
        <field name="prefix">VRFQ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_zc_rfq_comparison" model="ir.sequence">
        <field name="name">RFQ Comparison</field>
        <field name="code">zc.rfq.comparison</field>
        <field name="prefix">CMP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</data>
</odoo>
