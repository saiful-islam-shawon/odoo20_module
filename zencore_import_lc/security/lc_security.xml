<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bdcalling_lc" model="ir.module.category">
        <field name="name">BD Calling</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_lc_management" model="res.groups.privilege">
        <field name="name">Import LC</field>
        <field name="description">Approval rights for LC, CI, and amendment workflows.</field>
        <field name="category_id" ref="module_category_bdcalling_lc"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_lc_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_lc_management"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Can confirm, reject, cancel, reopen and approve LC workflow documents.</field>
    </record>
</odoo>
