<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bdcalling_lc" model="ir.module.category">
        <field name="name">BD Calling</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_lc_management" model="res.groups.privilege">
        <field name="name">Import LC</field>
        <field name="description">Approval rights for LC, CI, and amendment workflows.</field>
        <field name="category_id" ref="module_category_bdcalling_lc"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_lc_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_lc_management"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Can confirm, reject, cancel, reopen and approve LC workflow documents.</field>
    </record>

    <!-- Company isolation. These are global rules so other group rules cannot bypass them. -->
    <record id="lc_order_company_rule" model="ir.rule">
        <field name="name">LC Order: company isolation</field>
        <field name="model_id" ref="model_lc_order"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="lc_order_line_company_rule" model="ir.rule">
        <field name="name">LC Order Line: company isolation</field>
        <field name="model_id" ref="model_lc_order_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="import_lc_company_rule" model="ir.rule">
        <field name="name">Import LC: company isolation</field>
        <field name="model_id" ref="model_import_lc"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="import_lc_product_line_company_rule" model="ir.rule">
        <field name="name">Import LC Product Line: company isolation</field>
        <field name="model_id" ref="model_import_lc_product_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="import_lc_document_company_rule" model="ir.rule">
        <field name="name">Import LC Document: company isolation</field>
        <field name="model_id" ref="model_import_lc_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="lc_order_document_company_rule" model="ir.rule">
        <field name="name">LC Order Document: company isolation</field>
        <field name="model_id" ref="model_lc_order_document"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="import_ci_company_rule" model="ir.rule">
        <field name="name">Commercial Invoice: company isolation</field>
        <field name="model_id" ref="model_import_ci"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="import_ci_product_line_company_rule" model="ir.rule">
        <field name="name">Commercial Invoice Line: company isolation</field>
        <field name="model_id" ref="model_import_ci_product_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="import_lc_amendment_company_rule" model="ir.rule">
        <field name="name">LC Amendment: company isolation</field>
        <field name="model_id" ref="model_import_lc_amendment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="import_lc_amendment_line_company_rule" model="ir.rule">
        <field name="name">LC Amendment Line: company isolation</field>
        <field name="model_id" ref="model_import_lc_amendment_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="company_branch_company_rule" model="ir.rule">
        <field name="name">Company Branch: company isolation</field>
        <field name="model_id" ref="model_res_company_branch"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
