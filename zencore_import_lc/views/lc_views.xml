<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_lc_management" name="Import LC" sequence="10" web_icon="zencore_import_lc,static/description/icon.png"/>
    
    <!-- Action -->
    <record id="action_lc_order" model="ir.actions.act_window">
        <field name="name">Pro Forma Invoices</field>
        <field name="res_model">lc.order</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- Menu Item -->
    <menuitem id="menu_lc_orders" name="Proforma Invoice" parent="menu_lc_management" sequence="10" action="action_lc_order"/>
    
    <!-- CRITICAL: Block form view for LC Order Lines completely -->
    <record id="view_lc_order_line_form_disabled" model="ir.ui.view">
        <field name="name">lc.order.line.form.disabled</field>
        <field name="model">lc.order.line</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Product Line" create="false" edit="false" delete="false">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong>Product lines cannot be edited directly.</strong>
                        <p>These lines are automatically populated from the Work Order (PO).</p>
                        <p>To modify products, please change the Work Order in the main form.</p>
                    </div>
                    <group>
                        <field name="product_category_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="quantity" readonly="1"/>
                        <field name="product_uom_id" string="UOM" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="unit_price" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="subtotal" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List view for LC Order Line - prevents editing -->
    <record id="view_lc_order_line_list" model="ir.ui.view">
        <field name="name">lc.order.line.list</field>
        <field name="model">lc.order.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" string="Product Lines">
                <field name="product_category_id" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <field name="quantity" readonly="1"/>
                <field name="product_uom_id" string="UOM" readonly="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="unit_price" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="subtotal" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="PI Total"/>
              

            </list>
        </field>
    </record>
    
    <!-- List View -->
    <record id="view_lc_order_list" model="ir.ui.view">
        <field name="name">lc.order.list</field>
        <field name="model">lc.order</field>
        <field name="arch" type="xml">
            <list default_order="id desc" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="pi_number" required="1"/>
                <field name="po_number"/>
                <field name="vendor_id"/>
                <field name="bank_id"/>
                <field name="pi_date"/>
                <field name="expected_lc_opening_date"/>
                <field name="pi_terms"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_lc_order_form" model="ir.ui.view">
        <field name="name">lc.order.form</field>
        <field name="model">lc.order</field>
        <field name="arch" type="xml">
            <form string="Pro Forma Invoice">
                <header>
                <field name="is_registered_in_lc" invisible="1"/>
                <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                        invisible="state != 'draft'"/>
                <button name="action_cancel" string="Cancel" type="object" class="btn-warning" invisible="state == 'cancel' or is_registered_in_lc" confirm="Are you sure you want to cancel this Proforma Invoice?"/>

            <!-- Status bar -->
            <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
        </header>
                <sheet class="o_lc_management_sheet">
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_pi_documents" icon="attach_file" invisible="attachment_count == 0">
                            <field name="attachment_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    
                    <div class="o_lc_brand_header">
        <img src="/zencore_import_lc/static/description/icon.png" alt="Import LC"/>
        <div class="o_lc_brand_copy">
            <div class="o_lc_brand_title">Pro Forma Invoice</div>
            <div class="o_lc_brand_subtitle">Work order, PI terms and product snapshot for LC preparation</div>
        </div>
    </div>
                    <h1>
                        <field name="pi_number" required="1" placeholder="Enter supplier PI number" readonly="state != 'draft'"/>
                    </h1>
                    <group string="RFQ / PI Commercial Details" col="2">
                        <group>
                            <field name="po_number" readonly="state != 'draft'" domain="[('purchase_type', '=', 'import'), ('state', '!=', 'cancel'), ('company_id', '=', company_id)]"/>
                            <field name="vendor_id" readonly="1"/>
                            <field name="pi_date" readonly="state != 'draft'"/>
                            <field name="sc_number" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                            <field name="expected_shipment_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="bank_id" readonly="state != 'draft'"/>
                            <field name="payment_term_id" readonly="state != 'draft'"/>
                            <field name="lc_payment_terms" readonly="state != 'draft'"/>
                            <field name="pi_terms" readonly="state != 'draft'"/>
                            <field name="conversion_rate" string="Conversion Rate (PI Currency to Company Currency)"
                                   widget="monetary" options="{'currency_field': 'company_currency_id'}"
                                   readonly="state != 'draft'"/>
                            <field name="expected_lc_opening_date" readonly="state != 'draft'"/>
                        </group>
                            <field name="company_id" invisible="1"/>
                            <field name="company_currency_id" invisible="1"/>
                    </group>

                    <group string="Expected Logistics" col="2">
                        <group>
                            <field name="port_of_shipment_id" string="Preferred Port of Shipment" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="container_id" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="container_reference" readonly="state != 'draft'"/>
                            <field name="partial_shipment" string="Partial Shipment Allowed" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="destination_port_id" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="container_type_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="transshipment" string="Transshipment Allowed" readonly="state != 'draft'"/>
                            <field name="cnf_agent_id" readonly="state != 'draft'"/>
                        </group>
                            <field name="port_of_shipment" invisible="1"/>
                            <field name="destination_port" invisible="1"/>
                            <field name="shipment_container_name" invisible="1"/>
                    </group>
                    <group string="Indent Information" col="2">
                        <group>
                            <field name="indent_agent_id" readonly="state != 'draft'"/>
                            <field name="indent_commission_percent" invisible="not indent_agent_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="indent_commission_amount" invisible="not indent_agent_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <div class="alert alert-success mb-3" role="alert">
                        RFQ/PO defaults are copied automatically when the Work Order is selected. PI Number and PI Date remain vendor-document values.
                    </div>
                    
                    <notebook>
                        <page string="Products">
                            <!-- CRITICAL: Remove readonly from One2many field, but keep lines readonly -->
                            <!-- This allows Odoo to save the lines while preventing editing -->
                            <field name="lc_line_ids" nolabel="1" mode="list" options="{'no_open': True, 'no_create': True}" context="{'create': False, 'edit': False, 'delete': False}">
                                <list create="false" edit="false" delete="false" open="false" string="Product Lines" decoration-bf="1">
                                    <!-- force_save="1" ensures fields are saved even when readonly -->
                                    <field name="product_category_id" readonly="1" force_save="1"/>
                                    <field name="product_id" readonly="1" force_save="1"/>
                                    <field name="quantity" readonly="1" force_save="1"/>
                                    <field name="product_uom_id" string="UOM" readonly="1" force_save="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="unit_price" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="subtotal" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="PI Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" col="2">
                                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                <field name="amount_total_company" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                            </group>
                            
                            <!-- Info message -->
                            <div class="alert alert-info mt-3 o_lc_hint" role="alert">
                                <i class="oi" data-icon="info"/> <strong>Note:</strong> 
                                Product lines are automatically loaded from the selected Work Order (PO). 
                                To modify products, please change the Work Order selection above.
                            </div>
                        </page>
                        
                        
                        <page string="PI Term Descriptions">
                            <field name="pi_term_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="title" widget="text"/>
                                    <field name="description" widget="text"/>
                                </list>
                            </field>
                        </page>
                        <page string="Supporting Documents">
                            <div class="alert alert-info o_lc_hint" role="alert">
                                Attach the supplier's proforma invoice or other supporting documents. This is optional.
                            </div>
                            <field name="pi_document_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name" string="Document Name"/>
                                    <field name="file" filename="file_name" string="File"/>
                                    <field name="file_name" optional="hide"/>
                                    <field name="mimetype" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter Widget -->
                <chatter/> 
            </form>
        </field>
    </record>
</odoo>
