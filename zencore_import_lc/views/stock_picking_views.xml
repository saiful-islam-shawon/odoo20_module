<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_import_ci" model="ir.ui.view">
        <field name="name">stock.picking.form.import.ci</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="import_ci_id" readonly="1" invisible="picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
