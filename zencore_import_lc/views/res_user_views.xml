<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  
    <record id="view_users_form_security" model="ir.ui.view">
        <field name="name">res.users.form.security</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <group string="LC Approval Access">
                    <field name="is_approver" help="Backward-compatible flag. Prefer assigning the BD Calling / Import LC / Approver access right."/>

                </group>
            </xpath>
        </field>
    </record>
</odoo>
