<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Action -->
    <record id="action_import_lc" model="ir.actions.act_window">
        <field name="name">Import LCs</field>
        <field name="res_model">import.lc</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <!-- Menu Item -->
    <menuitem id="menu_import_lc" name="Import LC" parent="menu_lc_management" sequence="20" action="action_import_lc"/>
    
    <!-- List View -->
    <record id="view_import_lc_list" model="ir.ui.view">
        <field name="name">import.lc.list</field>
        <field name="model">import.lc</field>
        <field name="arch" type="xml">
            <list default_order="id desc" decoration-success="state == 'confirmed'" decoration-danger="state == 'reject'">
                <field name="lc_number" readonly="1"/>
                <field name="lc_type"/>
                <field name="pi_number"/><field name="supplier_id"/>
                <field name="buyer_id"/>
                <field name="applicant_bank_id"/>
                <field name="lc_opening_date"/>
                <field name="lc_expiry_date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="lc_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="lc_available_amount" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="total_lc_cost" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
            <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-danger="state == 'reject'"/></list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_import_lc_form" model="ir.ui.view">
        <field name="name">import.lc.form</field>
        <field name="model">import.lc</field>
        <field name="arch" type="xml">
            <form string="Import LC">
                <header>
                    <field name="is_current_user_approver" invisible="1"/>
                    <field name="can_create_commercial_invoice" invisible="1"/>
                    <field name="can_close_lc" invisible="1"/>
                   <!-- <button name="action_confirm"
                        string="Confirm Order"
                        type="object"
                        class="btn-primary"
                        invisible="not pi_number or state != 'draft'"/> -->
                        <button name="action_confirm" string="Confirm Order" type="object" class="btn-primary" invisible="not lc_order_id or state != 'draft' or not is_current_user_approver"/>
                    <button name="action_close" string="Close LC" type="object" class="btn-primary" invisible="state != 'confirmed' or not is_current_user_approver or not can_close_lc" confirm="Close this Import LC after all receipts are complete and all Vendor Bills are paid?"/>
                        

                    <button name="action_create_commercial_invoice" string="Create Commercial Invoice" type="object" class="oe_highlight" invisible="not can_create_commercial_invoice" help="Create a Commercial Invoice for the remaining LC product quantity"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done" decoration-danger="state == 'reject'"/>
                </header>
                <sheet class="o_lc_management_sheet">
                    <div class="oe_button_box" name="button_box">
        <button class="oe_stat_button" type="object" name="action_view_commercial_invoices" icon="fa-file-text-o" invisible="ci_count == 0">
            <field name="ci_count" widget="statinfo" string="Commercial Invoices"/>
        </button>
        <button class="oe_stat_button" type="object" name="action_view_vendor_bills" icon="fa-money" invisible="invoice_count == 0">
            <field name="invoice_count" widget="statinfo" string="Vendor Bills"/>
        </button>
        <button class="oe_stat_button" type="object" name="action_view_grn" icon="fa-truck" invisible="grn_count == 0">
            <field name="grn_count" widget="statinfo" string="GRNs"/>
        </button>
        <button class="oe_stat_button" type="object" name="action_view_landed_costs" icon="fa-calculator">
            <field name="landed_cost_count" widget="statinfo" string="Landed Costs"/>
        </button>
    </div><div class="o_lc_brand_header">
        <img src="/zencore_import_lc/static/description/icon.png" alt="Import LC"/>
        <div class="o_lc_brand_copy">
            <div class="o_lc_brand_title">Import Letter of Credit</div>
            <div class="o_lc_brand_subtitle">Banking, shipment, commercial invoice and landed-cost control</div>
        </div>
    </div>
                    <div class="oe_title">
                        <label for="lc_number"/>
                        <h1>
                            <field name="lc_number" readonly="state != 'draft'" placeholder="Enter bank-issued LC number"/>
                        </h1>
                    </div>
                    <group string="RFQ / LC COMMERCIAL DETAILS" col="2">
                        <group>
                            <field name="lc_order_id" string="Proforma Invoice" required="1" options="{'no_create': True, 'no_create_edit': True}" readonly="state != 'draft'"/>
                            <field name="pi_number" string="PI Number" readonly="1"/>
                            <field name="rfq_no" readonly="1"/>
                            <field name="rfq_date" readonly="1"/>
                            <field name="supplier_id" readonly="1"/>
                            <field name="supplier_address" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" string="Buyer / Company" readonly="1"/>
                            <field name="buyer_id" string="Buyer / Applicant" readonly="1"/>
                            <field name="purchase_reference" readonly="state != 'draft'"/>
                            <field name="responsible_buyer_id" readonly="state != 'draft'"/>
                            <field name="lc_type" readonly="state != 'draft'"/>
                            <field name="sc_number" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="BANK &amp; LC DATES" col="2">
                        <group>
                            <field name="applicant_bank_id" string="Issuing Bank" readonly="state != 'draft'"/>
                            <field name="advising_bank_id" readonly="state != 'draft'"/>
                            <field name="lc_opening_date" readonly="state != 'draft'"/>
                            <field name="lc_expiry_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="latest_shipment_date" readonly="state != 'draft'"/>
                            <field name="presentation_period_days" readonly="state != 'draft'"/>
                            <field name="lc_product_type" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="FINANCIAL TERMS" col="2">
                        <group>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="lc_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'"/>
                            <field name="lc_tolerance_percent" readonly="state != 'draft'"/>
                            <field name="lc_tolerance_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="lc_utilized_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="lc_available_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="lc_amount_bdt" string="LC Amount (Company Currency)" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                        </group>
                        <group>
                            <field name="payment_terms" readonly="state != 'draft'"/>
                            <field name="tenor_days" readonly="state != 'draft'"/>
                            <field name="lc_conversion_rate" string="Conversion Rate (LC Currency → Company Currency)"
                                   widget="monetary" options="{'currency_field': 'company_currency_id'}"
                                   readonly="state != 'draft'"/>
                            <field name="margin_rate" readonly="state != 'draft'"/>
                            <field name="margin_value" string="Margin Value (Company Currency)" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                            <field name="total_lc_cost" string="Total LC Cost (Company Currency)" widget="monetary" options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                        </group>
                    </group>

                    <group string="EXPECTED LOGISTICS" col="2">
                        <group>
                            <field name="expected_shipment_date" string="Shipment Date" readonly="1"/>
                            <field name="port_of_shipment_id" string="Preferred Port of Shipment" readonly="1" options="{'no_create': True}"/>
                            <field name="container_type_id" string="Container Type" readonly="1" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="destination_port_id" string="Destination Port" readonly="1" options="{'no_create': True}"/>
                            <field name="container_id" string="Configured Container" readonly="1" options="{'no_create': True}"/>
                            <field name="partial_shipment" string="Partial Shipment Allowed" readonly="state != 'draft'"/>
                            <field name="transshipment" string="Transshipment Allowed" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="AGENT INFORMATION" col="2">
                        <group>
                            <field name="indent_agent_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="cnf_agent_id" string="C&amp;F Agent" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Product Information">
    <!-- NON-EDITABLE LIST VIEW: Display only, no edit, no popup - Form remains saveable -->
                            <field name="product_line_ids" nolabel="1" readonly="state != 'draft'" options="{'no_open': True, 'no_create': True}">
                                <list create="false" edit="true" delete="false" open="false" string="Product Lines">
                                    <field name="product_id" column_invisible="1" readonly="1"/>
                                    <field name="product_category_id" optional="show" readonly="1"/>
                                    <field name="product_name" readonly="1"/>
                                    <field name="quantity" readonly="1"/>
                                    <field name="uom_id" string="UOM" readonly="1"/>
                                    <field name="hs_code" string="HS Code" readonly="parent.state != 'draft'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="unit_price" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_cost" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Cost"/>
                                </list>
                            </field>
                            
                            <!-- Info message -->
                            <div class="alert alert-info mt-3 o_lc_hint" role="alert">
                                <i class="fa fa-info-circle"/> <strong>Note:</strong> 
                                Product lines are automatically loaded from the selected PI. HS Code is optional and can be completed before or after LC confirmation.
                            </div>
                        </page>
                        <page string="Supporting Documents">
                            <field name="document_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="file" filename="file_name"/>
                                </list>
                            </field>
                        </page>

                        <page string="Other Charges" name="other_charges_tab">
                            <field name="journal_entry_ids"
                                   nolabel="1"
                                   mode="list,form"
                                   readonly="state == 'done'"
                                   context="{'default_move_type': 'entry', 'default_import_lc_id': id, 'default_company_id': company_id, 'default_currency_id': currency_id, 'default_ref': lc_number}">
                                <list string="Journal Entries" create="true" delete="false" edit="false">
                                    <field name="date" string="Date"/>
                                    <field name="name" string="Number"/>
                                    <field name="partner_id" string="Partner"/>
                                    <field name="ref" string="Reference" optional="show"/>
                                    <field name="journal_id" string="Journal"/>
                                    <field name="company_id" string="Company" groups="base.group_multi_company" optional="hide"/>
                                    <field name="import_lc_charge_total" string="Total" widget="monetary" options="{'currency_field': 'company_currency_id'}" sum="Total"/>
                                    <field name="company_currency_id" string="Currency" optional="show"/>
                                    <field name="state" string="Status" widget="badge"/>
                                </list>
                            </field>   
                        </page>

                        <page string="Amendments" name="amendments_tab">
                            <field name="amendment_ids" nolabel="1" readonly="state == 'done'">
                                <list decoration-success="state == 'approved'" decoration-info="state == 'submitted'" decoration-danger="state == 'rejected'" decoration-muted="state == 'cancelled'" create="0" delete="0">
                                    <field name="amendment_number"/>
                                    <field name="amendment_date"/>
                                    <field name="amendment_type"/>
                                    <field name="reason"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'submitted'" decoration-danger="state == 'rejected'" decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/> 
            </form>
        </field>
    </record>
</odoo>
